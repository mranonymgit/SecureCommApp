APP_NAME=SCA API
APP_ENV=production
# Comma-separated Web origins. Use * only during local setup.
CORS_ORIGINS=https://your-flutter-web-domain.example
# Render is IPv4-only: copy Supabase Connect > Session pooler (port 5432).
DATABASE_URL=postgresql+asyncpg://postgres.project-ref:url-encoded-password@aws-0-region.pooler.supabase.com:5432/postgres
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# Recommended: private ES256 JWK generated locally and imported in Supabase.
# It stays only in Render. A PEM private key is also accepted.
SUPABASE_JWT_SIGNING_KEY=your-private-jwk-json-or-pem
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_JWT_KEY_ID=the-kid-from-the-imported-key
# Legacy fallback only. Never use an anon/publishable or service-role key here.
SUPABASE_JWT_SECRET=
SUPABASE_REALTIME_TOKEN_EXPIRE_MINUTES=10
ENCRYPTION_KEY=change-me-for-pgcrypto-or-app-layer-encryption
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-legacy-anon-key-if-needed
# Prefer a new sb_secret_* server key. Keep service_role only for legacy projects.
SUPABASE_SECRET_KEY=your-server-only-sb-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-legacy-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=sca-media
SUPABASE_STORAGE_SIGNED_URL_SECONDS=900
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
